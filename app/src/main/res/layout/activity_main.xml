<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fardz X Vloid"
        android:textColor="@color/cyan_neon"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="30dp"/>

    <TextView
        android:id="@+id/tvOwner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="wanyeager"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeader"/>

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₱9999-10-11"
        android:textColor="@color/gray_light"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvOwner"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/labelBugNomor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BUG NOMOR"
        android:textColor="@color/cyan_neon"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDate"
        android:layout_marginTop="24dp"/>

    <EditText
        android:id="@+id/etBugNomor"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/input_bg"
        android:hint="+62XXXXXXXXXXX"
        android:inputType="phone"
        android:paddingStart="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/gray_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/labelBugNomor"/>

    <TextView
        android:id="@+id/labelBugGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BUG GROUP"
        android:textColor="@color/cyan_neon"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etBugNomor"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/etBugGroup"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/input_bg"
        android:hint="Group ID / Link"
        android:paddingStart="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/gray_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/labelBugGroup"/>

    <androidx.gridlayout.GridLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:columnCount="2"
        android:rowCount="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etBugGroup">

        <Button
            android:id="@+id/btnHome"
            style="@style/MenuButton"
            android:text="Home" />

        <Button
            android:id="@+id/btnWhatsApp"
            style="@style/MenuButton"
            android:text="WhatsApp" />

        <Button
            android:id="@+id/btnInfo"
            style="@style/MenuButton"
            android:text="info" />

        <Button
            android:id="@+id/btnTools"
            style="@style/MenuButton"
            android:text="Tools" />

        <Button
            android:id="@+id/btnGlobalChat"
            style="@style/MenuButton"
            android:text="Global Chat" />

    </androidx.gridlayout.GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>